<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MyPlayer</RootNamespace>
    <AssemblyName>MPLC</AssemblyName>
    <ApplicationTitle>MPLC</ApplicationTitle>
    <Version>1.0.0</Version>
    <Product>MPLC</Product>
    <Company>personal</Company>
    <ApplicationIcon>MPLC.ico</ApplicationIcon>
    <Copyright>Personal use — powered by mpv (libmpv)</Copyright>
    <!-- Allows compiling this Windows-only WPF project on Linux (dev environment).
         Running the app still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HanumanInstitute.LibMpv" Version="0.10.1" />
  </ItemGroup>

  <!-- Copy the mpv engine DLL (fetched by scripts/fetch-mpv.ps1) to build output.
       Condition keeps builds working on machines that haven't fetched it yet. -->
  <ItemGroup Condition="Exists('..\..\native\win-x64\libmpv-2.dll')">
    <None Include="..\..\native\win-x64\libmpv-2.dll"
          Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release packaging (see scripts/publish.ps1 + .github/workflows/release.yml):
       self-contained single exe for win-x64, with native libs extracted beside it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)'!=''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Default mpv.conf / input.conf shipped inside the exe, written to
       %APPDATA%\MyPlayer\ on first run. -->
  <ItemGroup>
    <EmbeddedResource Include="Defaults\mpv.conf" />
    <EmbeddedResource Include="Defaults\input.conf" />
  </ItemGroup>

</Project>
