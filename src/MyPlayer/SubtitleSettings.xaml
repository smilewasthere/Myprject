<Window x:Class="MyPlayer.SubtitleSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitle Settings" Height="600" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#DDDDDD"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#55555C"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="GroupStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>

            <!-- Font & style -->
            <GroupBox Header="Font &amp; style" Style="{StaticResource GroupStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Font:"/>
                        <ComboBox x:Name="FontCombo" Grid.Column="1" IsEditable="True" Margin="0,0,8,0">
                            <ComboBoxItem Content="sans-serif"/>
                            <ComboBoxItem Content="serif"/>
                            <ComboBoxItem Content="monospace"/>
                            <ComboBoxItem Content="Segoe UI"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Consolas"/>
                            <ComboBoxItem Content="Tahoma"/>
                            <ComboBoxItem Content="Verdana"/>
                        </ComboBox>
                        <CheckBox x:Name="BoldCheck" Grid.Column="2" Content="Bold"
                                  Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ItalicCheck" Grid.Column="3" Content="Italic"
                                  Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- size row is built in code -->
                    <StackPanel x:Name="SizeSection"/>
                </StackPanel>
            </GroupBox>

            <!-- Colors -->
            <GroupBox Header="Colors" Style="{StaticResource GroupStyle}">
                <StackPanel>
                    <TextBlock Text="Text fill" Foreground="#999999" Margin="0,0,0,3"/>
                    <WrapPanel x:Name="TextColorSwatches"/>
                    <Border x:Name="TextColorPreview" Height="14" Margin="0,3,0,0" CornerRadius="2"/>

                    <TextBlock Text="Outline" Foreground="#999999" Margin="0,8,0,3"/>
                    <WrapPanel x:Name="BorderColorSwatches"/>
                    <Border x:Name="BorderColorPreview" Height="14" Margin="0,3,0,0" CornerRadius="2"/>

                    <TextBlock Text="Shadow" Foreground="#999999" Margin="0,8,0,3"/>
                    <WrapPanel x:Name="ShadowColorSwatches"/>
                    <Border x:Name="ShadowColorPreview" Height="14" Margin="0,3,0,0" CornerRadius="2"/>

                    <TextBlock Text="Background (opacity only for SRT)" Foreground="#999999" Margin="0,8,0,3"/>
                    <WrapPanel x:Name="BackColorSwatches"/>
                    <Border x:Name="BackColorPreview" Height="14" Margin="0,3,0,0" CornerRadius="2"/>
                </StackPanel>
            </GroupBox>

            <!-- Outline / shadow / scale -->
            <GroupBox Header="Outline, shadow &amp; scale" Style="{StaticResource GroupStyle}">
                <StackPanel x:Name="ScaleSection"/>
            </GroupBox>

            <!-- Position -->
            <GroupBox Header="Position" Style="{StaticResource GroupStyle}">
                <StackPanel x:Name="PositionSection"/>
            </GroupBox>

            <!-- Timing -->
            <GroupBox Header="Timing" Style="{StaticResource GroupStyle}">
                <StackPanel>
                    <StackPanel x:Name="TimingSection"/>
                    <TextBlock Text="Positive = show later, negative = show earlier. Applies live."
                               Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- ASS override -->
            <GroupBox Header="ASS typesetting override" Style="{StaticResource GroupStyle}">
                <StackPanel>
                    <TextBlock Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,6">
                        Whether these settings override an embedded .ass file's own
                        styling (signs, karaoke). &quot;Force&quot; makes these win over ASS.
                    </TextBlock>
                    <ComboBox x:Name="AssOverrideCombo">
                        <ComboBoxItem Content="Auto (respect file)" Tag="auto"/>
                        <ComboBoxItem Content="Yes — override ASS" Tag="yes"/>
                        <ComboBoxItem Content="Force — always use these" Tag="force"/>
                        <ComboBoxItem Content="Scale only" Tag="scale"/>
                        <ComboBoxItem Content="No — keep ASS as-is" Tag="strip"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton" Content="Reset to defaults" Click="Reset_Click"/>
                <Button Content="Close" IsDefault="True" Click="Close_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
